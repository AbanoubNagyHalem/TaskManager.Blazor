@page "/register"

@inject AuthApiClient AuthApiClient
@inject AuthStateService AuthState
@inject ApiErrorMessageProvider ApiErrorMessageProvider
@inject NavigationManager Navigation

<PageTitle>Register</PageTitle>


<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-md-6 col-lg-5">

            <div class="card shadow-sm">

                <div class="card-body p-4">

                    <h1 class="h3 mb-3">
                        Create Account
                    </h1>


                    <p class="text-muted mb-4">
                        Create your Task Manager account.
                    </p>


                    @if (!string.IsNullOrWhiteSpace(
                            errorMessage))
                    {
                        <div class="alert alert-danger">
                            @errorMessage
                        </div>
                    }


                    <EditForm Model="@model" OnValidSubmit="HandleRegisterAsync">

                        <DataAnnotationsValidator />


                        <div class="mb-3">

                            <label class="form-label">
                                Name
                            </label>


                            <InputText class="form-control" @bind-Value="model.Name" placeholder="Your name" />


                            <ValidationMessage For="@(() => model.Name)" />

                        </div>


                        <div class="mb-3">

                            <label class="form-label">
                                Email
                            </label>


                            <InputText class="form-control" @bind-Value="model.Email" placeholder="you@example.com" />


                            <ValidationMessage For="@(() => model.Email)" />

                        </div>


                        <div class="mb-4">

                            <label class="form-label">
                                Password
                            </label>


                            <InputText type="password" class="form-control" @bind-Value="model.Password"
                                       placeholder="At least 6 characters" />


                            <ValidationMessage For="@(() => model.Password)" />

                        </div>


                        <button type="submit" class="btn btn-dark w-100" disabled="@isSubmitting">

                            @if (isSubmitting)
                            {
                                <span class="spinner-border spinner-border-sm me-2">
                                </span>

                                <span>
                                    Creating account...
                                </span>
                            }
                            else
                            {
                                <span>
                                    Register
                                </span>
                            }

                        </button>

                    </EditForm>


                    <div class="text-center mt-4">

                        <span>
                            Already have an account?
                        </span>

                        <a href="/login">
                            Login
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


@code {
    private readonly RegisterRequest model =
        new();


    private bool isSubmitting;


    private string? errorMessage;


    private async Task HandleRegisterAsync()
    {
        try
        {
            isSubmitting =
                true;


            errorMessage =
                null;


            HttpResponseMessage response =
                await AuthApiClient.RegisterAsync(
                    model);


            if (!response.IsSuccessStatusCode)
            {
                errorMessage =
                    await ApiErrorMessageProvider
                        .GetMessageAsync(
                            response,
                            "Could not create account.");

                return;
            }


            AuthResponse? authResponse =
                await response.Content
                    .ReadFromJsonAsync<AuthResponse>();


            if (authResponse is null)
            {
                errorMessage =
                    "The account was created, but the login response could not be read.";

                return;
            }


            await AuthState.SetUserAsync(
                authResponse);


            Navigation.NavigateTo(
                "/");
        }
        catch (HttpRequestException)
        {
            errorMessage =
                "Could not connect to the API.";
        }
        finally
        {
            isSubmitting =
                false;
        }
    }
}