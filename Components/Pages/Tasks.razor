@page "/tasks"

@inject TaskApiClient TaskApiClient
@inject AuthenticatedPageGuard PageGuard
@inject ApiErrorMessageProvider ApiErrorMessageProvider
@inject IJSRuntime JS

<PageTitle>Tasks</PageTitle>


<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4 gap-3">

        <div>

            <h1 class="mb-1">
                My Tasks
            </h1>

            <p class="text-muted mb-0">
                Manage your personal tasks.
            </p>

        </div>


        <a
            href="/tasks/create"
            class="btn btn-dark">

            + Add Task

        </a>

    </div>


    <TaskFilters
        Search="@query.Search"
        SearchChanged="OnSearchChanged"
        Status="@query.Status"
        StatusChanged="OnStatusChanged"
        Priority="@query.Priority"
        PriorityChanged="OnPriorityChanged"
        SortBy="@query.SortBy"
        SortByChanged="OnSortByChanged"
        SortDirection="@query.SortDirection"
        SortDirectionChanged="OnSortDirectionChanged"
        OnApply="ApplyFiltersAsync" />


    <ErrorState Message="@errorMessage" />


    @if (isLoading)
    {
        <LoadingState
            Message="Loading tasks..." />
    }
    else if (tasks.Count == 0)
    {
        <EmptyState
            Icon="✅"
            Title="No tasks found"
            Message="Create a task or change your filters." />
    }
    else
    {
        <div class="row g-3">

            @foreach (
                TaskResponse task
                in tasks)
            {
                <div class="col-md-6 col-xl-4">

                    <TaskCard
                        Id="@task.Id"
                        Title="@task.Title"
                        Description="@task.Description"
                        DueDate="@task.DueDate"
                        Priority="@task.Priority"
                        Status="@task.Status"
                        OnDelete="DeleteTaskAsync" />

                </div>
            }

        </div>


        <TaskPagination
            CurrentPage="@query.Page"
            TotalPages="@totalPages"
            TotalCount="@totalCount"
            OnPrevious="PreviousPageAsync"
            OnNext="NextPageAsync" />
    }

</div>


@code {
    private List<TaskResponse> tasks =
        [];


    private TaskQueryParameters query =
        new()
        {
            Page = 1,
            PageSize = 6,
            SortDirection = "asc"
        };


    private bool isLoading =
        true;


    private string? errorMessage;


    private int totalCount;


    private int totalPages;


    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }


        bool allowed =
            await PageGuard
                .EnsureAuthenticatedAsync();


        if (!allowed)
        {
            return;
        }


        await LoadTasksAsync();


        StateHasChanged();
    }


    private async Task LoadTasksAsync()
    {
        try
        {
            isLoading =
                true;


            errorMessage =
                null;


            PagedResponse<TaskResponse>? response =
                await TaskApiClient.GetAllAsync(
                    query);


            if (response is null)
            {
                tasks =
                    [];

                totalCount =
                    0;

                totalPages =
                    0;

                return;
            }


            tasks =
                response.Items;


            totalCount =
                response.TotalCount;


            totalPages =
                response.TotalPages;
        }
        catch (HttpRequestException)
        {
            tasks =
                [];

            totalCount =
                0;

            totalPages =
                0;


            errorMessage =
                "Could not load tasks.";
        }
        finally
        {
            isLoading =
                false;
        }
    }


    private Task OnSearchChanged(
        string? value)
    {
        query.Search =
            value;

        return Task.CompletedTask;
    }


    private Task OnStatusChanged(
        TaskItemStatus? value)
    {
        query.Status =
            value;

        return Task.CompletedTask;
    }


    private Task OnPriorityChanged(
        TaskPriority? value)
    {
        query.Priority =
            value;

        return Task.CompletedTask;
    }


    private Task OnSortByChanged(
        string? value)
    {
        query.SortBy =
            value;

        return Task.CompletedTask;
    }


    private Task OnSortDirectionChanged(
        string value)
    {
        query.SortDirection =
            value;

        return Task.CompletedTask;
    }


    private async Task ApplyFiltersAsync()
    {
        query.Page =
            1;


        await LoadTasksAsync();
    }


    private async Task PreviousPageAsync()
    {
        if (query.Page <= 1)
        {
            return;
        }


        query.Page--;


        await LoadTasksAsync();
    }


    private async Task NextPageAsync()
    {
        if (query.Page >= totalPages)
        {
            return;
        }


        query.Page++;


        await LoadTasksAsync();
    }


    private async Task DeleteTaskAsync(
        int taskId)
    {
        bool confirmed =
            await JS.InvokeAsync<bool>(
                "confirm",
                "Are you sure you want to delete this task?");


        if (!confirmed)
        {
            return;
        }


        try
        {
            errorMessage =
                null;


            HttpResponseMessage response =
                await TaskApiClient.DeleteAsync(
                    taskId);


            if (response.IsSuccessStatusCode)
            {
                await LoadTasksAsync();

                return;
            }


            errorMessage =
                await ApiErrorMessageProvider
                    .GetMessageAsync(
                        response,
                        $"Could not delete task. Status: {(int)response.StatusCode}");
        }
        catch (HttpRequestException)
        {
            errorMessage =
                "Could not connect to the API.";
        }
    }
}