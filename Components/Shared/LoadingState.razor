<div class="d-flex align-items-center gap-3 p-4 bg-white border rounded">

    <div
        class="spinner-border"
        role="status">

        <span class="visually-hidden">
            Loading...
        </span>

    </div>


    <span>
        @Message
    </span>

</div>


@code {
    [Parameter]
    public string Message { get; set; } =
        "Loading...";
}