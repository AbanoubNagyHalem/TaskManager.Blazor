<div class="text-center p-5 bg-white border rounded">

    <div class="display-6 mb-3">
        @Icon
    </div>


    <h3 class="h5">
        @Title
    </h3>


    <p class="text-muted mb-0">
        @Message
    </p>

</div>


@code {
    [Parameter]
    public string Icon { get; set; } =
        "📭";


    [Parameter]
    public string Title { get; set; } =
        "Nothing here";


    [Parameter]
    public string Message { get; set; } =
        "";
}