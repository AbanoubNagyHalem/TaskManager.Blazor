<div class="card h-100 shadow-sm">

  <div class="card-body">

    <div class="d-flex align-items-center gap-3">

      <div class="fs-2">
        @Icon
      </div>


      <div>

        <div class="text-muted small">
          @Label
        </div>


        <div class="fs-3 fw-bold">
          @Value
        </div>

      </div>

    </div>

  </div>

</div>


@code {
  [Parameter]
  public string Icon { get; set; } =
      "📊";


  [Parameter]
  public string Label { get; set; } =
      "";


  [Parameter]
  public int Value { get; set; }
}